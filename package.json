{
  "name": "@butcool/spm",
  "version": "0.1.0",
  "description": "Declarative SKILL.md dependency manager for AI coding agents",
  "author": "butcool <but.cool@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butfool/spm.git"
  },
  "homepage": "https://github.com/butfool/spm#readme",
  "bugs": {
    "url": "https://github.com/butfool/spm/issues"
  },
  "type": "module",
  "bin": {
    "spm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "skill",
    "claude-code",
    "agents",
    "package-manager"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
